# Copy this file to .env.local and fill in once your Supabase project exists.
# When both values are empty (the default), the app runs in localStorage-only
# mode — every service in src/lib/ falls back to its mock implementation, so
# the UI is fully exercisable without any backend.

# From: Supabase dashboard → Project Settings → API → "Project URL"
VITE_SUPABASE_URL=

# From: Supabase dashboard → Project Settings → API → "anon public" key
VITE_SUPABASE_ANON_KEY=
